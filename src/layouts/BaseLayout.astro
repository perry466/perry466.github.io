---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/prose.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
import Seo from "../components/Seo.astro";
import T from "../components/T.astro";
import { clientStrings } from "../i18n/ui";
import { site } from "../site.config";
import { getAllPosts } from "../utils/posts";

interface Props {
  title: string;
  titleEn?: string;
  description: string;
  descriptionEn?: string;
  path: string;
  type?: "website" | "article";
  lang?: "zh" | "en";
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** 是否启用阅读进度条 */
  progress?: boolean;
}

const {
  title,
  titleEn,
  description,
  descriptionEn,
  path,
  type = "website",
  lang = "zh",
  image,
  imageAlt,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  noindex,
  progress = false,
} = Astro.props;

/** 站内是否存在英文内容：决定首次访问是否跟随浏览器语言切到英文，避免空白列表 */
const posts = await getAllPosts();
const hasEn = posts.some((post) => post.data.lang === "en");
const showProgress = progress && site.ui.showReadingProgress;
---

<!doctype html>
<html
  lang={lang === "en" ? "en" : "zh-CN"}
  data-theme="light"
  data-mode="system"
  data-locale="zh"
  data-has-en={hasEn ? "true" : "false"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      titleEn={titleEn}
      description={description}
      descriptionEn={descriptionEn}
      path={path}
      type={type}
      lang={lang}
      image={image}
      imageAlt={imageAlt}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      jsonLd={jsonLd}
      noindex={noindex}
    />

    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* 主题与语言必须尽早执行，避免刷新闪白；同时也是 no-JS 降级的中文默认值来源 */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          // 新前缀 whitespace:，同时兼容旧版本写入的 liubai:
          var storedTheme =
            localStorage.getItem("whitespace:theme") || localStorage.getItem("liubai:theme");
          var mode =
            storedTheme === "light" || storedTheme === "dark" || storedTheme === "system"
              ? storedTheme
              : "system";
          root.dataset.mode = mode;
          root.dataset.theme =
            mode === "system"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
              : mode;

          var storedLocale =
            localStorage.getItem("whitespace:locale") || localStorage.getItem("liubai:locale");
          var locale = storedLocale === "en" || storedLocale === "zh" ? storedLocale : null;
          if (!locale) {
            var prefersEnglish = (navigator.language || "zh").toLowerCase().indexOf("zh") !== 0;
            locale = prefersEnglish && root.dataset.hasEn === "true" ? "en" : "zh";
          }
          root.dataset.locale = locale;
          root.lang = locale === "en" ? "en" : "zh-CN";

          var title = document.querySelector("title[data-title-zh]");
          if (title) {
            var next = locale === "en" ? title.dataset.titleEn : title.dataset.titleZh;
            if (next) document.title = next;
          }
        } catch (error) {
          /* localStorage 不可用时保持默认中文与浅色 */
        }
      })();
    </script>

    <script
      type="application/json"
      id="site-i18n"
      set:html={JSON.stringify({ strings: clientStrings })}
    />
  </head>

  <body>
    {showProgress ? <div class="reading-progress" data-progress aria-hidden="true"></div> : null}

    <a class="skip-link" href="#main"><T k="site.skipToContent" /></a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <Search />

    <slot name="overlays" />

    {
      site.features.analytics && site.umami.src && site.umami.websiteId ? (
        <script
          is:inline
          defer
          src={site.umami.src}
          data-website-id={site.umami.websiteId}
        />
      ) : null
    }

    <script>
      import { initUI } from "../scripts/ui";
      initUI();
    </script>
  </body>
</html>
