---
import PostCard from "./PostCard.astro";
import type { Post } from "../utils/posts";

interface Props {
  posts: Post[];
  /** list：细线列表；card：卡片网格 */
  style?: "list" | "card";
}

const { posts, style = "list" } = Astro.props;
---

<ul class:list={["post-list", style === "card" ? "post-list--cards" : "post-list--bordered"]}>
  {
    posts.map((post) => (
      <PostCard post={post} />
    ))
  }
</ul>
