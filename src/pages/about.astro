---
import PageHead from "../components/PageHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
import { breadcrumbJsonLd, pageTitle } from "../utils/seo";
---

<BaseLayout
  title={pageTitle({ title: "关于" })}
  titleEn={pageTitle({ title: "About", locale: "en" })}
  description={`关于${site.author}：前端工程师，写界面、工具链与可维护性，以及为什么这个站点选择少而清楚。`}
  path="/about/"
  jsonLd={breadcrumbJsonLd([
    { name: "首页", path: "/" },
    { name: "关于", path: "/about/" },
  ])}
>
  <div class="container">
    <PageHead
      titleZh="关于"
      titleEn="About"
      metaZh={site.startYear ? `始于 ${site.startYear}` : undefined}
      metaEn={site.startYear ? `Since ${site.startYear}` : undefined}
    />

    <div class="prose page-prose">
      <p>
        我是{site.author}，前端工程师。日常做的事是把界面调稳、把加载压短，也把团队里重复的手工活换成脚本。写了十年代码，仍然会为一个两像素的对齐问题耗掉半小时。
      </p>
      <p>
        相信「少而清楚」比「多而齐全」更难做，也更值得做。所以这个站点没有点赞、没有阅读量统计，读完就走是正常状态。
      </p>

      <h2>现在在做</h2>
      <ul>
        <li>维护两个自己每天在用的开源小工具：一个 Markdown 整理器，一个本地图片压缩脚本。</li>
        <li>把一套用了三年的设计令牌从零重写，去掉一半历史遗留的颜色。</li>
        <li>慢速读一本讲系统的书，每章都要停下来想一会儿，进度大概每月一章。</li>
      </ul>

      <h2>关注方向</h2>
      <table>
        <thead>
          <tr><th>方向</th><th>具体内容</th></tr>
        </thead>
        <tbody>
          <tr><td>排版与可读性</td><td>中文正文的行高、字距与标点节奏，长文怎样才能读得下去</td></tr>
          <tr><td>构建与交付</td><td>静态站点的构建耗时、缓存策略，以及部署链路上能删掉的环节</td></tr>
          <tr><td>可维护性</td><td>功能删减、配置收敛，让别人和三个月后的自己都能接手</td></tr>
        </tbody>
      </table>

      <h2>写作习惯</h2>
      <p>
        先写最丑的一稿，允许逻辑不通、允许没有结论，改的时候再当编辑。写和改是两种需要不同心态的工作，混在一起做，两边都做不好。
      </p>

      <h2>关于这个站点</h2>
      <p>
        静态生成，没有数据库，也没有自建后端。内容写在 Markdown 里，push 即发布；评论与统计默认关闭，页面不加载多余脚本。
      </p>
      <p>
        想聊点什么，可以写信到 <a href="mailto:hello@example.com">hello@example.com</a>（示例地址，不是真实邮箱）。
      </p>
    </div>

  </div>
</BaseLayout>
