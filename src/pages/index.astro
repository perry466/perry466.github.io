---
import IntroCard from "../components/IntroCard.astro";
import PostList from "../components/PostList.astro";
import T from "../components/T.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
import { getAllPosts, getPinned, withoutPinned } from "../utils/posts";
import { pageTitle, websiteJsonLd } from "../utils/seo";

const posts = await getAllPosts();
const pinned = getPinned(posts);
const latest = withoutPinned(posts, pinned).slice(0, site.postsPerPage);
const listStyle = site.ui.postListStyle;
/** 打字机句子双语打包给脚本：切换语言时重新开始 */
const typedLines = JSON.stringify({ zh: site.hero.lines, en: site.hero.linesEn });
const firstLine = site.hero.lines[0] ?? "";
---

<BaseLayout
  title={pageTitle()}
  titleEn={pageTitle({ locale: "en" })}
  description={site.description}
  descriptionEn={site.descriptionEn}
  path="/"
  jsonLd={websiteJsonLd()}
>
  <div class="container">
    {
      site.ui.showHomeHero ? (
        <section class="hero">
          {/* 打字机：脚本接管前隐藏，无 JS 时直接显示第一句 */}
          <p class="hero__typed" aria-hidden="true">
            <span class="hero__typed-text" data-typed data-typed-lines={typedLines}>{firstLine}</span>
            <span class="hero__caret"></span>
          </p>
          {/* 读屏用：把每句话完整说出来，避免反复朗读打字过程 */}
          <p class="visually-hidden">
            <span class="t-zh">{site.hero.lines.join(" ")}</span>
            <span class="t-en">{site.hero.linesEn.join(" ")}</span>
          </p>
          <div class="hero__actions">
            <a class="text-link" href="/posts/">
              <T k="home.all" />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a class="text-link" href="/about/">
              <T k="nav.about" />
            </a>
            <a class="text-link" href="/rss.xml">RSS</a>
          </div>
        </section>
      ) : null
    }

    {
      pinned.length > 0 ? (
        <section class="section">
          <div class="section__head">
            <h2 class="section__title">
              <T k="home.pinned" />
            </h2>
          </div>
          <PostList posts={pinned} style={listStyle} />
        </section>
      ) : null
    }

    <section class="section">
      <div class="section__head">
        <h2 class="section__title">
          <T k="home.latest" />
        </h2>
        <a class="section__more" href="/posts/">
          <T k="home.all" /> →
        </a>
      </div>

      {
        latest.length > 0 ? (
          <PostList posts={latest} style={listStyle} />
        ) : (
          <div class="empty-state">
            <p>
              <T k="list.empty" />
            </p>
          </div>
        )
      }
    </section>
  </div>

  <IntroCard />
</BaseLayout>

<script>
  import { initTypedHero } from "../scripts/typed-hero";
  initTypedHero();
</script>
