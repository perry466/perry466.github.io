---
import PageHead from "../components/PageHead.astro";
import T from "../components/T.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatISO, formatMonth, toDateTime } from "../utils/format";
import { categoryOf } from "../utils/categories";
import { getAllPosts, groupByYearMonth, postSlug } from "../utils/posts";
import { tf } from "../i18n/ui";
import { breadcrumbJsonLd, pageTitle } from "../utils/seo";

const posts = await getAllPosts();
const groups = groupByYearMonth(posts);

/** 密度条的级数：超过 4 篇统一按最高级显示，避免格子高低差太夸张 */
const level = (count: number): number => (count === 0 ? 0 : Math.min(count, 4));
---

<BaseLayout
  title={pageTitle({ title: "归档" })}
  titleEn={pageTitle({ title: "Archive", locale: "en" })}
  description="按年月浏览全部文章。"
  descriptionEn="Browse every post by year and month."
  path="/archive/"
  jsonLd={breadcrumbJsonLd([
    { name: "首页", path: "/" },
    { name: "归档", path: "/archive/" },
  ])}
>
  <div class="container">
    <PageHead
      titleZh="归档"
      titleEn="Archive"
      descZh="按年月浏览全部文章。"
      descEn="Browse every post by year and month."
      metaZh={tf("zh", "list.total", { n: posts.length })}
      metaEn={tf("en", "list.total", { n: posts.length })}
    />

    {
      groups.length > 0 ? (
        <>
          {/* 年份条：吸顶，滚动时高亮当前年份 */}
          <nav class="archive-rail" aria-label="年份 / Years" data-archive-rail>
            {groups.map((group) => (
              <a
                class="archive-rail__item"
                href={`#y${group.year}`}
                data-rail-year={group.year}
              >
                <span class="archive-rail__year">{group.year}</span>
                <span class="archive-rail__count">{group.count}</span>
              </a>
            ))}
          </nav>

          {groups.map((group) => (
            <section
              class="archive-year"
              id={`y${group.year}`}
              data-archive-year={group.year}
            >
              <header class="archive-year__head">
                <h2 class="archive-year__title">{group.year}</h2>
                <span class="archive-year__count">
                  <T k="archive.count" vars={{ n: group.count }} />
                </span>

                {/* 12 格月度密度：有文章的月份可以点，悬停会在下方对应月份上给出反馈 */}
                <ol class="archive-strip" aria-label={`${group.year} 年各月篇数`}>
                  {group.density.map((count, index) => {
                    const month = String(index + 1).padStart(2, "0");
                    const key = `${group.year}-${month}`;
                    const label = `${group.year} 年 ${Number(month)} 月 · ${count} 篇`;
                    return (
                      <li>
                        {count > 0 ? (
                          <a
                            class="archive-strip__cell"
                            href={`#m${group.year}${month}`}
                            data-level={level(count)}
                            data-strip-month={key}
                            data-tip={label}
                            aria-label={label}
                          />
                        ) : (
                          <span class="archive-strip__cell is-empty" data-level="0" aria-hidden="true" />
                        )}
                      </li>
                    );
                  })}
                </ol>
              </header>

              <div class="archive-months">
                {group.months.map((month) => (
                  <details
                    class="archive-month"
                    id={`m${group.year}${month.month}`}
                    data-month-panel={`${group.year}-${month.month}`}
                    open
                  >
                    <summary class="archive-month__head">
                      <span class="archive-month__label">
                        <span class="t-zh">{formatMonth(month.month, "zh")}</span>
                        <span class="t-en">{formatMonth(month.month, "en")}</span>
                      </span>
                      <span class="archive-month__rule" aria-hidden="true" />
                      <span class="archive-month__count">
                        <T k="archive.count" vars={{ n: month.count }} />
                      </span>
                      <svg
                        class="archive-month__chevron"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M6 9l6 6 6-6" />
                      </svg>
                    </summary>

                    <ul class="archive-list">
                      {month.posts.map((post) => {
                        const category = categoryOf(post);
                        return (
                          <li data-post-lang={post.data.lang}>
                            <time datetime={toDateTime(post.data.pubDate)}>
                              {formatISO(post.data.pubDate).slice(8)}
                            </time>
                            <span class="archive-list__main">
                              <a href={`/posts/${postSlug(post)}/`}>{post.data.title}</a>
                              <span class="archive-list__meta">
                                <a class="archive-list__cat" href={`/categories/${category.slug}/`}>
                                  <span class="t-zh">{category.label}</span>
                                  <span class="t-en">{category.labelEn}</span>
                                </a>
                                <span class="lang-flag" data-lang={post.data.lang}>
                                  {post.data.lang === "en" ? "EN" : "中文"}
                                </span>
                              </span>
                            </span>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                ))}
              </div>
            </section>
          ))}
        </>
      ) : (
        <div class="empty-state">
          <p>
            <T k="list.empty" />
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  import { initArchive } from "../scripts/archive";
  initArchive();
</script>
