---
import PageHead from "../components/PageHead.astro";
import T from "../components/T.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatISO, formatMonth, toDateTime } from "../utils/format";
import { categoryOf } from "../utils/categories";
import { getAllPosts, groupByYearMonth, postSlug } from "../utils/posts";
import { tf } from "../i18n/ui";
import { breadcrumbJsonLd, pageTitle } from "../utils/seo";

const posts = await getAllPosts();
const groups = groupByYearMonth(posts);
---

<BaseLayout
  title={pageTitle({ title: "归档" })}
  titleEn={pageTitle({ title: "Archive", locale: "en" })}
  description="按年月浏览全部文章。"
  descriptionEn="Browse every post by year and month."
  path="/archive/"
  jsonLd={breadcrumbJsonLd([
    { name: "首页", path: "/" },
    { name: "归档", path: "/archive/" },
  ])}
>
  <div class="container">
    <PageHead
      titleZh="归档"
      titleEn="Archive"
      descZh="按年月浏览全部文章。"
      descEn="Browse every post by year and month."
      metaZh={tf("zh", "list.total", { n: posts.length })}
      metaEn={tf("en", "list.total", { n: posts.length })}
    />

    {
      groups.length > 0 ? (
        <div class="timeline" data-timeline>
          {groups.map((group) => (
            <section class="tl-year-block" id={`y${group.year}`} data-archive-year={group.year}>
              <h2 class="tl-year">
                <span class="tl-year__num">{group.year}</span>
                <span class="tl-year__count">
                  <T k="archive.count" vars={{ n: group.count }} />
                </span>
              </h2>

              {group.months.map((month) => (
                <div class="tl-month-block" id={`m${group.year}${month.month}`}>
                  <h3 class="tl-month">
                    <span class="tl-month__name">
                      <span class="t-zh">{formatMonth(month.month, "zh")}</span>
                      <span class="t-en">{formatMonth(month.month, "en")}</span>
                    </span>
                    <span class="tl-month__count">
                      <T k="archive.count" vars={{ n: month.count }} />
                    </span>
                  </h3>

                  <ul class="tl-list">
                    {month.posts.map((post) => {
                      const category = categoryOf(post);
                      const iso = formatISO(post.data.pubDate);
                      return (
                        <li class="tl-post" data-post-lang={post.data.lang}>
                          <time class="tl-post__date" datetime={toDateTime(post.data.pubDate)}>
                            {iso.slice(5)}
                          </time>
                          <a class="tl-post__title" href={`/posts/${postSlug(post)}/`}>
                            {post.data.title}
                          </a>
                          <span class="tl-post__meta">
                            <a class="tl-post__cat" href={`/categories/${category.slug}/`}>
                              <span class="t-zh">{category.label}</span>
                              <span class="t-en">{category.labelEn}</span>
                            </a>
                            <span class="lang-flag" data-lang={post.data.lang}>
                              {post.data.lang === "en" ? "EN" : "中文"}
                            </span>
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </section>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>
            <T k="list.empty" />
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  import { initArchive } from "../scripts/archive";
  initArchive();
</script>
