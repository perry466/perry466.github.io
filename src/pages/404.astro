---
import T from "../components/T.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../utils/seo";
---

<BaseLayout
  title={pageTitle({ title: "页面不存在" })}
  titleEn={pageTitle({ title: "Page not found" })}
  description="这个地址没有对应内容，可能已被移动或删除。"
  descriptionEn="This address has no content. It may have moved or been deleted."
  path="/404/"
  noindex={true}
>
  <div class="container">
    <section class="notfound">
      <p class="notfound__code">404</p>
      <h1 class="notfound__title">
        <T k="404.title" />
      </h1>
      <p>
        <span class="t-zh">这个地址没有对应内容，可能已被移动或删除。</span>
        <span class="t-en">This address has no content. It may have moved or been deleted.</span>
      </p>
      <div class="notfound__actions">
        <a class="text-link" href="/">
          ← <T k="404.back" />
        </a>
        <a class="text-link" href="/posts/">
          <T k="home.all" /> →
        </a>
        <a class="text-link" href="/tags/">
          <T k="nav.tags" /> →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
