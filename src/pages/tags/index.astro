---
import PageHead from "../../components/PageHead.astro";
import T from "../../components/T.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts, collectTags } from "../../utils/posts";
import { tf } from "../../i18n/ui";
import { breadcrumbJsonLd, pageTitle } from "../../utils/seo";

const posts = await getAllPosts();
const tags = collectTags(posts);
---

<BaseLayout
  title={pageTitle({ title: "标签" })}
  titleEn={pageTitle({ title: "Tags", locale: "en" })}
  description="全部标签及其文章数量。"
  descriptionEn="All tags with post counts."
  path="/tags/"
  jsonLd={breadcrumbJsonLd([
    { name: "首页", path: "/" },
    { name: "标签", path: "/tags/" },
  ])}
>
  <div class="container">
    <PageHead
      titleZh="标签"
      titleEn="Tags"
      descZh="全部标签及其文章数量。"
      descEn="All tags with post counts."
      metaZh={tf("zh", "tags.total", { n: tags.length })}
      metaEn={tf("en", "tags.total", { n: tags.length })}
    />

    {
      tags.length > 0 ? (
        <ul class="tag-cloud">
          {tags.map((tag) => (
            <li>
              <a class="chip" href={`/tags/${tag.slug}/`}>
                {tag.name}
                <span class="chip__count">{tag.count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <p>
            <T k="tags.empty" />
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
